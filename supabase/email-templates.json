{
  "mailer_subjects_confirmation": "Confirm your Sweetbites account",
  "mailer_templates_confirmation_content": "<div style=\"background:#f4f0ec;padding:32px 16px;font-family:Georgia,serif;color:#323335\"><div style=\"max-width:480px;margin:0 auto;background:#ffffff;border-radius:16px;padding:32px;border:1px solid #e7aca7\"><p style=\"margin:0 0 8px;font-size:12px;letter-spacing:0.14em;color:#aa1d50;text-transform:uppercase\">Sweetbites</p><h1 style=\"margin:0 0 16px;font-size:24px;color:#aa1d50\">Confirm your email</h1><p style=\"margin:0 0 24px;line-height:1.5\">Thanks for signing up. Tap the button below to confirm your account.</p><p style=\"margin:0 0 24px\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#aa1d50;color:#ffffff;text-decoration:none;padding:12px 24px;border-radius:999px;font-family:Arial,sans-serif;font-size:14px\">Confirm email</a></p><p style=\"margin:0;font-size:13px;color:#6b6c6e\">If you didn’t create this account, you can ignore this email.</p></div></div>",
  "mailer_subjects_recovery": "Reset your Sweetbites password",
  "mailer_templates_recovery_content": "<div style=\"background:#f4f0ec;padding:32px 16px;font-family:Georgia,serif;color:#323335\"><div style=\"max-width:480px;margin:0 auto;background:#ffffff;border-radius:16px;padding:32px;border:1px solid #e7aca7\"><p style=\"margin:0 0 8px;font-size:12px;letter-spacing:0.14em;color:#aa1d50;text-transform:uppercase\">Sweetbites</p><h1 style=\"margin:0 0 16px;font-size:24px;color:#aa1d50\">Reset your password</h1><p style=\"margin:0 0 24px;line-height:1.5\">We received a request to reset your password. Tap the button below to choose a new one.</p><p style=\"margin:0 0 24px\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#aa1d50;color:#ffffff;text-decoration:none;padding:12px 24px;border-radius:999px;font-family:Arial,sans-serif;font-size:14px\">Reset password</a></p><p style=\"margin:0;font-size:13px;color:#6b6c6e\">If you didn’t ask for this, you can ignore this email.</p></div></div>",
  "mailer_subjects_magic_link": "Your Sweetbites sign-in link",
  "mailer_templates_magic_link_content": "<div style=\"background:#f4f0ec;padding:32px 16px;font-family:Georgia,serif;color:#323335\"><div style=\"max-width:480px;margin:0 auto;background:#ffffff;border-radius:16px;padding:32px;border:1px solid #e7aca7\"><p style=\"margin:0 0 8px;font-size:12px;letter-spacing:0.14em;color:#aa1d50;text-transform:uppercase\">Sweetbites</p><h1 style=\"margin:0 0 16px;font-size:24px;color:#aa1d50\">Sign in</h1><p style=\"margin:0 0 24px;line-height:1.5\">Tap the button below to sign in. This link expires shortly and can only be used once.</p><p style=\"margin:0 0 24px\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#aa1d50;color:#ffffff;text-decoration:none;padding:12px 24px;border-radius:999px;font-family:Arial,sans-serif;font-size:14px\">Sign in</a></p></div></div>",
  "mailer_subjects_email_change": "Confirm your new Sweetbites email",
  "mailer_templates_email_change_content": "<div style=\"background:#f4f0ec;padding:32px 16px;font-family:Georgia,serif;color:#323335\"><div style=\"max-width:480px;margin:0 auto;background:#ffffff;border-radius:16px;padding:32px;border:1px solid #e7aca7\"><p style=\"margin:0 0 8px;font-size:12px;letter-spacing:0.14em;color:#aa1d50;text-transform:uppercase\">Sweetbites</p><h1 style=\"margin:0 0 16px;font-size:24px;color:#aa1d50\">Confirm your new email</h1><p style=\"margin:0 0 24px;line-height:1.5\">Tap the button below to confirm {{ .NewEmail }} as your new address.</p><p style=\"margin:0 0 24px\"><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#aa1d50;color:#ffffff;text-decoration:none;padding:12px 24px;border-radius:999px;font-family:Arial,sans-serif;font-size:14px\">Confirm new email</a></p><p style=\"margin:0;font-size:13px;color:#6b6c6e\">If you didn’t ask for this, you can ignore this email.</p></div></div>"
}
