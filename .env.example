# Supabase (required for live order storage + auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Auth dashboard setup:
# 1. Authentication → Providers → enable Google + Facebook (add OAuth client IDs/secrets)
# 2. Authentication → URL Configuration:
#    Site URL = http://localhost:3000 (or your production domain)
#    Redirect URLs = http://localhost:3000/auth/callback
#                    https://your-domain.com/auth/callback
# 3. Run supabase/schema.sql (includes profiles + order user_id)

# Order emails — Resend (https://resend.com). Orders still save if these are empty.
# Free: send from onboarding@resend.dev. Custom From needs a domain.
RESEND_API_KEY=
RESEND_FROM=Sweetbites <onboarding@resend.dev>
ORDER_NOTIFY_EMAIL=owner@email.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Square hosted checkout (https://developer.squareup.com/apps). Leave empty to keep pay-later orders.
# SQUARE_ENV=sandbox or production
# SQUARE_ACCESS_TOKEN=
# SQUARE_LOCATION_ID=
# SQUARE_WEBHOOK_SIGNATURE_KEY=
# NEXT_PUBLIC_SQUARE_PAY=1
# SUPABASE_SERVICE_ROLE_KEY=

# Canada Post Rating 4.0.0 — server-side only (never NEXT_PUBLIC_).
# Production app must have Rating 4.0.0 added (Get access). Origin is the kitchen.
# CPC_CUSTOMER_NUMBER=
# CPC_API_KEY=
# CPC_API_SECRET=
# CPC_ORIGIN_POSTAL=T4R3G7
